{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Entry points that a static import graph cannot discover. index.ts and install.mjs are
  // omitted because knip already infers them from package.json "exports" and "bin".
  // The runner and inspector are spawned as separate processes; the runner-peer shims are
  // resolved at runtime; the test suites are executed directly by `node --test`.
  "entry": [
    "inspector-runner.mjs",
    "async-retention-discovery-worker.mjs",
    "runner-peer-loader.mjs",
    "runner-peer-preload.mjs",
    "scripts/*.mjs",
    "src/api/*.ts",
    "src/inspectors/inspector-runner.ts",
    "src/runs/background/binary-bootstrap.ts",
    "src/runs/background/subagent-runner.ts",
    "test/smoke/*.mjs",
    "test/smoke/*.ts",
    "test/unit/*.test.ts",
    "test/integration/*.test.ts"
  ],
  "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs", "*.mjs"],

  // KNIP 6 WARNING (verified empirically 2026-10-02): with knip 6.39.0 this key suppresses far
  // more than its documented "used in same file" semantics — planted unused exports went
  // unreported and the finding count collapsed (102 exports → 9). knip 5 behaved as documented.
  // It is REMOVED; the pre-existing backlog it used to hide (exports/types) is instead demoted
  // to "warn" below: printed on every run, non-blocking until the burn-down lands, while every
  // other issue type stays a hard error. Known residual blind spot: knip 6 never reports unused
  // exports from src/shared/utils.ts (verified: probes at four positions unflagged while the
  // same content under a different path is fully reported; cause unidentified, upstream issue
  // material) — dead exports in that one file need manual review.
  "rules": { "exports": "warn", "types": "warn" },

  // acorn is require()'d through a runtime-resolved path in scripted-workflow.ts, so there is
  // no static import to follow. oxlint and its plugin pack are driven by .oxlintrc.json rather
  // than a package script. pi-coding-agent resolves to test/fixtures/...-shim, which is the
  // host API surface the tests type against.
  "ignoreDependencies": ["acorn", "oxlint"],

  // Every entry here is a false positive with a real consumer that knip cannot see.
  //
  // settings.ts: createChainDir, resolveChainTemplates and resolveParallelBehaviors are read
  // as `settings?.<name>` off `await tryImport<any>(...)` in
  // test/integration/template-resolution.test.ts, which loads the module dynamically and
  // property-accesses it through `any`. knip 5's ignoreIssues has no per-symbol form, so this
  // exempts the whole file: a NEW dead export in settings.ts would not be reported. Cost is
  // measured, not assumed — with entry-exemption off, these three are the only settings.ts
  // findings, so nothing else is hidden.
  //
  // runner-aliases.ts: findHostPeerPackageDir is consumed by test/smoke/clean-install.mjs
  // through a jiti-loaded copy of the compiled module.
  //
  // tool-timeout.ts / external-runs.ts: each keeps one older name as an alias of its
  // canonical export.
  //
  // npm-background.mjs: bwrap (Bubblewrap) is an optional sandboxing binary invoked via
  // spawnSync on Linux x64; it is not a JavaScript dependency.
  //
  // pi-coding-agent shim: declaration files reference internal modules unresolvable outside
  // the package; knip 6 reads .d.ts files for unresolved imports.
  "ignoreIssues": {
    "src/shared/settings.ts": ["exports"],
    "src/runs/background/runner-aliases.ts": ["exports"],
    "src/runs/shared/tool-timeout.ts": ["duplicates"],
    "src/api/external-runs.ts": ["duplicates"],
    "test/smoke/npm-background.mjs": ["binaries"],
    "test/fixtures/pi-coding-agent-shim/**": ["unlisted", "unresolved"]
  }
}
